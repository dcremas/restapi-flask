# Copy to /etc/restapi/restapi.env on the server (root-owned, chmod 0640,
# group ec2-user). Never commit the real file.

# --- Database -------------------------------------------------------------
# The API connects as api_ro: SELECT on five tables, read-only transactions,
# an 8s statement timeout. See deploy/sql/roles.sql.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=api_ro
PG_PASSWORD=CHANGE_ME

# Per-database overrides, if either ever moves off this host:
#DATABASE_URL_WEATHERDATA=postgresql://...
#DATABASE_URL_APPLE_WEATHERKIT=postgresql://...

# --- Behaviour ------------------------------------------------------------
# Cache lifetimes in seconds. Historical rows never change once ingested;
# forecasts are refreshed continuously, so they get a short window.
CACHE_HISTORICAL=3600
CACHE_FORECAST=300

# /dates defaults to this many days back rather than grouping the whole table.
DEFAULT_DATE_WINDOW_DAYS=60

# Hard ceiling on any single query. Must stay below gunicorn's timeout (30s) so
# Postgres cancels a slow query and the client gets a 503, rather than gunicorn
# killing the worker mid-request.
STATEMENT_TIMEOUT_MS=8000

# Connections per database PER WORKER. workers x POOL_MAX_SIZE x 2 databases
# must stay under api_ro's CONNECTION LIMIT of 10.
POOL_MAX_SIZE=2

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
LOG_LEVEL=INFO
